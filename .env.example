# --- Supabase / Postgres (PostGIS) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql://user:password@host:5432/postgres

# --- Object storage for COGs (Cloudflare R2 or S3-compatible) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=arda-piosphere-cogs
R2_ENDPOINT_URL=
# Public/read base URL if bucket is fronted by a CDN (optional, else use S3 client reads)
COG_PUBLIC_BASE_URL=

# --- Google Earth Engine ---
# Service account json key path (mounted secret) or inline JSON
GEE_SERVICE_ACCOUNT_EMAIL=
GEE_SERVICE_ACCOUNT_KEY_PATH=./secrets/gee-service-account.json
GEE_PROJECT_ID=
# GEE can only batch-export to Google Drive, EE assets, or GCS — not directly
# to R2. We export to a staging area, then the export script copies each
# finished COG into R2 and deletes the staging copy.
#
# Two supported staging destinations (set ONE):
#   - GEE_EXPORT_GCS_BUCKET: a GCS bucket (requires a Google Cloud billing
#     account)
#   - GEE_EXPORT_DRIVE_FOLDER: a Google Drive folder (FREE, no billing). The
#     folder must be shared with the GEE service account email. Each COG is
#     auto-deleted from Drive after it is uploaded to R2.
GEE_EXPORT_GCS_BUCKET=
GEE_EXPORT_DRIVE_FOLDER=
GOOGLE_APPLICATION_CREDENTIALS=./secrets/gee-service-account.json

# --- WhatsApp Business Cloud API (Meta) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=change-me-webhook-verify-token
WHATSAPP_APP_SECRET=

# --- Data sources ---
# WPDx (Water Point Data Exchange) API key, if using the API rather than a bulk export
WPDX_API_KEY=

# --- Azure OpenAI (GPT-5-mini) — optional smart layer ---
# Project-scoped endpoint from Azure AI Foundry (…/api/projects/<project>).
# If unset, the app falls back to deterministic rules (fail-open).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_MODEL=gpt-5-mini

# --- Azure AI Speech (voice-note transcription) ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=southafricanorth

# --- Misc ---
ENVIRONMENT=development
LOG_LEVEL=INFO


